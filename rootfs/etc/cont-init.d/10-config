#!/usr/bin/bashio
# Load HA options and export as env for Windmill.
# bashio enables nounset (set -u) on source — disable it immediately so
# bashio::config returning empty doesn't crash us.
set +u
set +e

source /usr/bin/bashio

DATABASE_URL=$(bashio::config 'database_url' '')
BASE_URL=$(bashio::config 'base_url' 'http://homeassistant.local:8000')
WORKER_COUNT=$(bashio::config 'worker_count' '1')
LOG_LEVEL=$(bashio::config 'log_level' 'info')
DATA_PATH=$(bashio::config 'data_path' '/share/windmill')

# Write env file for run.sh
# Upstream env vars (from docker-compose.yml):
#   DATABASE_URL  — Postgres connection string (required)
#   MODE          — 'server' or 'worker' (default: both in one process)
#   BASE_URL      — public URL (optional, for generating links)
{
    echo "DATABASE_URL=${DATABASE_URL}"
    echo "MODE=server"
    echo "BASE_URL=${BASE_URL}"
    echo "RUST_LOG=${LOG_LEVEL}"
    echo "DATA_PATH=${DATA_PATH}"
} > /tmp/.windmill-env

mkdir -p "${DATA_PATH}"
echo "[10-config] env written, DATA_PATH=${DATA_PATH}"